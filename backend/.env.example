# Copia este archivo a ".env" (sin ".example") y rellena los valores reales.
# En produccion (Render), estas mismas variables se configuran en el panel de
# Render, no en un archivo.

SUPABASE_URL=
SUPABASE_KEY=

# Para "Enviar directamente por email" al marcar un archivo (opcional: sin
# esto configurado, esa opcion simplemente falla con un aviso claro, todo
# lo demas de la app sigue funcionando igual). Se obtiene en resend.com.
RESEND_API_KEY=
# Remitente que vera el destinatario. Sin verificar tu propio dominio en
# Resend, solo puedes usar "onboarding@resend.dev" -- y con ese remitente
# gratuito, Resend solo deja enviar al email con el que te registraste en
# resend.com (no a destinatarios cualquiera). Ver README para el detalle.
RESEND_FROM_EMAIL=onboarding@resend.dev
